# Copy to .env.local, or just run `npm run setup` which generates it with real secrets.
# Every value below is LOCAL. ValueBack needs no third-party account or API key.

# SQLite file. Relative paths resolve from the project root.
DATABASE_URL=./data/valueback.db

# Where uploaded documents are written. Must be outside ./public.
STORAGE_DIR=./storage

# REQUIRED. 32 random bytes, base64. Encrypts gift-card / voucher codes (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Session lifetime in hours (default 720 = 30 days).
SESSION_TTL_HOURS=720

# Optional, development only. When "1", Settings exposes a plan switcher so the
# entitlement system can be exercised without a payment provider. Ignored in production.
# VALUEBACK_DEV_PLAN_OVERRIDE=1
